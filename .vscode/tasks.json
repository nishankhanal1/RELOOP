{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Reloop: Start Vite",
			"type": "shell",
			"command": "npm.cmd run dev -- --host 127.0.0.1 --port 5173 --strictPort",
			"isBackground": true,
			"problemMatcher": {
				"owner": "vite",
				"pattern": {
					"regexp": "^$"
				},
				"background": {
					"activeOnStart": true,
					"beginsPattern": ".*",
					"endsPattern": "http://localhost:5173/"
				}
			}
		},
		{
			"label": "Start Reloop dev server",
			"type": "shell",
			"command": "npm run dev",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Start Reloop dev server (npm.cmd)",
			"type": "shell",
			"command": "npm.cmd run dev",
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Build Reloop",
			"type": "shell",
			"command": "npm.cmd run build",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build Reloop after hero removal",
			"type": "shell",
			"command": "npm.cmd run build",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build Reloop after background removal",
			"type": "shell",
			"command": "npm.cmd run build",
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Build Reloop after hero background removal",
			"type": "shell",
			"command": "npm.cmd run build",
			"isBackground": false,
			"problemMatcher": []
		}
	]
}