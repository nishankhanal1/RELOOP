# Supabase project settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Canonical production origin. Set this before building/deploying to generate sitemap.xml.
VITE_SITE_URL=https://www.example.com

# Optional Google Analytics 4 measurement ID (for example G-XXXXXXXXXX).
# Analytics runs only for visitors who accept analytics in the privacy banner.
VITE_GA4_ID=
