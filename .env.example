# Supabase project settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-key

# Canonical production origin. Set this to your exact HTTPS origin before
# building/deploying. On Vercel, VERCEL_PROJECT_PRODUCTION_URL is used when this
# is blank, with the current production URL as the final fallback.
VITE_SITE_URL=https://www.example.com

# Optional Google Search Console HTML-tag verification token.
# Leave blank until Search Console gives you the token for this property.
VITE_GOOGLE_SITE_VERIFICATION=

# Optional Bing Webmaster Tools verification token (msvalidate.01).
VITE_BING_SITE_VERIFICATION=

# Optional Google Analytics 4 measurement ID (for example G-XXXXXXXXXX).
# Analytics runs only for visitors who accept analytics in the privacy banner.
VITE_GA4_ID=
